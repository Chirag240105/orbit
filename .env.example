# Copy to .env (never commit .env). The backend reads ./.env or ../.env.

# --- Model gateway (NVIDIA Hosted API default) ---
# Choose nvidia (default/development/demo), nebius (submission), or demo (no network model calls).
LLM_PROVIDER=nvidia

# NVIDIA API Key from build.nvidia.com (Bearer token starting with nvapi-)
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Configured NVIDIA Nemotron model family IDs:
MODEL_PLANNER=nvidia/nemotron-3.5-super-vl-120b-a12b
MODEL_FAST=nvidia/nemotron-3.5-lightning-30b-a3b
MODEL_TINY=nvidia/nemotron-3.5-bolt-e4b
MODEL_EMBED=nvidia/nemotron-3.5-embed-1b
MODEL_FALLBACK=nvidia/nemotron-3-super-120b-a12b

ORBIT_EMBEDDING_DIMENSION=2048
ORBIT_EMBEDDING_FALLBACK_MODEL=sentence-transformers/all-MiniLM-L6-v2
ORBIT_PROVIDER_TIMEOUT_S=90
ORBIT_PROVIDER_RETRIES=1

# --- Nebius Token Factory (Enable when access is available) ---
# NEBIUS_API_KEY=
# NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/

# --- Development without a key ---
# true = deterministic placeholder replies, clearly labeled "Demo". No model is called.
ORBIT_DEMO_MODE=false
ORBIT_MOCK_AI=false

# --- Backend ---
ORBIT_DATABASE_URL=postgresql+psycopg://orbit:orbit-dev-only@localhost:5432/orbit
# Generate and set a stable random secret for a deployment. Blank uses a temporary process secret.
ORBIT_JWT_SECRET=
ORBIT_JWT_LIFETIME_MINUTES=60
ORBIT_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ORBIT_MAX_FILE_BYTES=200000
