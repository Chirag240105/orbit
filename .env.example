# Copy to .env (never commit .env). The backend reads ./.env or ../.env.

# --- Model provider: NVIDIA Nemotron via Nebius Token Factory (OpenAI-compatible) ---
# Create a key in the Nebius Token Factory console. Leave empty to run unconfigured.
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
# UNVERIFIED default. Run `python scripts/list_models.py` and pick a current Nemotron ID.
NEBIUS_MODEL=nvidia/Nemotron-3-Nano-30B-A3B
# Output budget per call. Nemotron reasons before answering; raise this if you see provider_empty_response.
NEBIUS_MAX_TOKENS=4096

# --- Development without a key ---
# true = deterministic placeholder replies, clearly labeled "Demo". No model is called.
ORBIT_DEMO_MODE=false

# --- Backend ---
ORBIT_DATABASE_URL=sqlite:///./orbit.db
ORBIT_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ORBIT_MAX_FILE_BYTES=200000
ORBIT_CHAT_RATE_LIMIT=30

# --- Agent behaviour ---
# true = ask the model which skill fits when you don't pick one (one extra model call per message).
ORBIT_MODEL_ROUTING=false
# Extra model calls allowed to repair a reply that doesn't match the skill's schema (0-2).
ORBIT_REPAIR_RETRIES=1

# --- Local API token ---
# Leave unset: a random token is generated at each backend start and written to ORBIT_TOKEN_FILE
# (default: .orbit-token in the repo root, git-ignored). The Vite dev server reads it and adds it to /api requests.
# ORBIT_API_TOKEN=
# ORBIT_TOKEN_FILE=
