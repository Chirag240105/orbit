# Copy to .env (never commit .env). The backend reads ./.env or ../.env.

# --- Model gateway ---
# Choose nebius (submission), nvidia (development), or demo (no network model calls).
LLM_PROVIDER=nebius
# Create the key for the selected hosted provider. Leave blank for labeled demo mode.
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# Choose IDs returned by `python scripts/list_models.py` for the active provider.
MODEL_PLANNER=
MODEL_FAST=
MODEL_EMBED=
ORBIT_EMBEDDING_DIMENSION=384
ORBIT_EMBEDDING_FALLBACK_MODEL=sentence-transformers/all-MiniLM-L6-v2
ORBIT_PROVIDER_TIMEOUT_S=90
ORBIT_PROVIDER_RETRIES=1

# --- Development without a key ---
# true = deterministic placeholder replies, clearly labeled "Demo". No model is called.
ORBIT_DEMO_MODE=false
ORBIT_MOCK_AI=false

# --- Backend ---
ORBIT_DATABASE_URL=sqlite:///./orbit.db
ORBIT_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ORBIT_MAX_FILE_BYTES=200000
