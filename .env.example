# Copy to .env (never commit .env). The backend reads ./.env or ../.env.

# --- Model provider: NVIDIA Nemotron via Nebius Token Factory (OpenAI-compatible) ---
# Create a key in the Nebius Token Factory console. Leave empty to run unconfigured.
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
# UNVERIFIED default. Run `python scripts/list_models.py` and pick a current Nemotron ID.
NEBIUS_MODEL=nvidia/Nemotron-3-Nano-30B-A3B

# --- Development without a key ---
# true = deterministic placeholder replies, clearly labeled "Demo". No model is called.
ORBIT_DEMO_MODE=false

# --- Backend ---
ORBIT_DATABASE_URL=sqlite:///./orbit.db
ORBIT_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ORBIT_MAX_FILE_BYTES=200000
